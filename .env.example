# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / "publishable" key (safe for the browser; NOT the service_role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this deployment (no trailing slash), e.g. https://pharmacia.app
# Used to build password-reset and email-confirmation links.
NEXT_PUBLIC_SITE_URL=

# Server-side only: never expose this in the browser.
# Needed by administrators who issue staff logins, and by the Super Admin console
# (it reads across workspaces, which RLS forbids for a normal session).
# Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Super Admin (platform operator)
# ---------------------------------------------------------------------------
# Comma-separated allowlist. Only these accounts may open /superadmin.
SUPER_ADMIN_EMAIL=
# The private phrase asked for at /superadmin/gate. Long and random.
SUPER_ADMIN_PASSCODE=
# Optional but recommended: a long random string used to sign the operator
# session cookie. Without it the key is derived from the passphrase.
SUPER_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Customer e-billing (invoice PDFs by email)
# ---------------------------------------------------------------------------
# Optional. Without it, invoices can still be downloaded and printed; the
# "Email invoice" button explains what is missing.
RESEND_API_KEY=
# Default sender for every pharmacy on the platform, e.g.
# "Pharmacia Billing <invoices@yourdomain.com>".
#
# The address must sit on a domain verified at Resend (Domains → add domain →
# add the DNS records it shows you). A pharmacy can override the sender with its
# own address in Settings → Pharmacy, but only once that pharmacy's domain is
# verified too; otherwise Resend rejects the message.
#
# Left blank (or if a pharmacy sets no sender) invoices fall back to Resend's
# onboarding@resend.dev sandbox address, which only delivers to the Resend
# account owner — enough to test the flow, not enough to serve customers.
INVOICE_FROM_EMAIL=
